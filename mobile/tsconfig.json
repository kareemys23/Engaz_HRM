{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "types": ["node", "@wdio/globals/types", "@wdio/mocha-framework"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "./dist"
  },
  "include": ["specs/**/*.ts", "Pages/**/*.ts", "Locators/**/*.ts", "Utils/**/*.ts", "wdio.conf.ts"]
}
